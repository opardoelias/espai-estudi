---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { getT, locales } from '../i18n';

interface Props {
  title: string;
  description: string;
  // Equivalent URL of this page in each language, for hreflang links.
  alternates?: Partial<Record<string, string>>;
}

const { title, description, alternates = {} } = Astro.props;
const { lang, global } = getT(Astro.currentLocale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={global.meta.ogLocale} />
    {locales.filter((l) => alternates[l]).map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l]!, Astro.site ?? Astro.url).href} />)}
    {alternates.ca && <link rel="alternate" hreflang="x-default" href={new URL(alternates.ca, Astro.site ?? Astro.url).href} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300..600&display=swap"
    />
  </head>
  <body class="pb-16 md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ivory focus:px-4 focus:py-2">
      {global.meta.skipLink}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />

    <script>
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' }
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
