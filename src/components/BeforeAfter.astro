---
// Draggable before/after comparison. The range input drives the clip of the "after" layer.
// Without a "before" photo, that side shows a neutral stand-in with a "photo to come" note.
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  before?: ImageMetadata;
  beforeAlt?: string;
  after?: ImageMetadata;
  afterAlt: string;
  labels: { before: string; after: string; slider: string; beforePending: string };
  class?: string;
}

const { before, beforeAlt, after, afterAlt, labels, class: className = '' } = Astro.props;
---

<div class:list={['before-after relative select-none overflow-hidden', className]} style="--pos: 50%">
  <Photo image={before} alt={beforeAlt ?? labels.beforePending} tones={['#B9B1A6', '#7D756C']} class="absolute inset-0">
    {!before && <span class="label absolute bottom-4 left-4 max-w-[45%] !text-white/90">{labels.beforePending}</span>}
  </Photo>
  <Photo image={after} alt={afterAlt} sizes="(min-width: 768px) 60vw, 100vw" class="ba-after absolute inset-0" />
  <span class="label absolute left-4 top-4 bg-ivory/90 px-2.5 py-1 !text-ink">{labels.before}</span>
  <span class="label absolute right-4 top-4 bg-ivory/90 px-2.5 py-1 !text-ink">{labels.after}</span>
  <div class="ba-handle pointer-events-none absolute inset-y-0 w-px bg-ivory" aria-hidden="true">
    <span class="absolute left-1/2 top-1/2 grid h-11 w-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-ivory bg-ink/40 text-ivory backdrop-blur-sm">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" /></svg>
    </span>
  </div>
  <input type="range" min="0" max="100" value="50" aria-label={labels.slider} class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
</div>

<style>
  /* .ba-after sits on the Photo child component, outside this component's style scope */
  .before-after :global(.ba-after) { clip-path: inset(0 0 0 var(--pos)); }
  .ba-handle { left: var(--pos); }
  .before-after:has(input:focus-visible) .ba-handle span { outline: 2px solid var(--color-terracotta); outline-offset: 3px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.before-after').forEach((el) => {
    const input = el.querySelector('input');
    input?.addEventListener('input', () => el.style.setProperty('--pos', `${input.value}%`));
  });
</script>
