---
import { getT } from '../../i18n';
const { home } = getT(Astro.currentLocale);
import SectionIntro from '../SectionIntro.astro';
const p = home.process;
---

<section class="section" aria-labelledby="process-title">
  <div class="container-site">
    <SectionIntro eyebrow={p.eyebrow} title={p.title} id="process-title" />
    <ol class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
      {p.steps.map((step, i) => (
        <li class="reveal border-t border-travertine pt-5">
          <span class="font-display text-[48px] font-heading leading-none text-bronze">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mb-2 mt-4 !text-[20px]">{step.title}</h3>
          <p class="text-[15px] text-stone">{step.text}</p>
        </li>
      ))}
    </ol>
    <p class="mt-12"><a href={p.href} class="btn-link">{p.link}</a></p>
  </div>
</section>
