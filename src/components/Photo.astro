---
// Project photograph (optimised via astro:assets), or a gradient stand-in when no photo exists yet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  tones?: string[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  position?: string;
  class?: string;
}

const {
  image,
  alt,
  tones = ['#D6C8B4', '#8C6E55'],
  sizes = '(min-width: 768px) 50vw, 100vw',
  loading = 'lazy',
  position = 'center',
  class: className = ''
} = Astro.props;
const [from, to] = tones;
---

<div
  class:list={['overflow-hidden', !className.includes('absolute') && 'relative', className]}
  style={image ? undefined : `background:
    radial-gradient(ellipse at 75% 15%, rgba(255,248,236,.55) 0 12%, transparent 42%),
    linear-gradient(165deg, ${from}, ${to});`}
  role={image ? undefined : 'img'}
  aria-label={image ? undefined : alt}
>
  {image && (
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200, 1600, 2000]}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
      class="absolute inset-0 h-full w-full object-cover"
      style={`object-position:${position}`}
    />
  )}
  <slot />
</div>
